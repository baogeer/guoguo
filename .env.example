# 复制本文件为 .env 并填入真实值
# .env 已在 .gitignore 里，不会被提交

# 走 apifox 分享的网关 gate.aidingqing.com
# Key 由该网关发放（非官方 DeepSeek key）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认 base_url 和模型
# DEEPSEEK_BASE_URL=https://gate.aidingqing.com/v1
# DEEPSEEK_MODEL=q-deepseek-v4-flash   # 便宜快；换 q-deepseek-v4-pro 质量更高
